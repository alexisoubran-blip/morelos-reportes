{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/morelos-reporte_online-mayo-julio-2026/index.html"
    },
    {
      "source": "/google-reviews",
      "destination": "/morelos-reporte_online-mayo-julio-2026/google-reviews/index.html"
    },
    {
      "source": "/google-reviews/:path*",
      "destination": "/morelos-reporte_online-mayo-julio-2026/google-reviews/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/morelos-reporte_online-mayo-julio-2026/:path*"
    }
  ],
  "headers": [
    {
      "source": "/data/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/:path*",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
