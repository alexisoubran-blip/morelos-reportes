{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "morelos-reporte_online-mayo-julio-2026",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/google-reviews/",
      "destination": "/google-reviews",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/google-reviews",
      "destination": "/google-reviews-v3/index.html"
    },
    {
      "source": "/data/comments/:path*",
      "destination": "/google-reviews/data/comments/:path*"
    }
  ],
  "headers": [
    {
      "source": "/google-reviews",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/google-reviews/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
